# Names only. Never commit real values.

DATABASE_URL=postgresql+psycopg://cropscan:cropscan@localhost:5432/cropscan

# The API's DB role. Must NOT hold UPDATE/DELETE on ledger_entry (PRD 7.2).
LEDGER_DB_ROLE=cropscan_app

# S3-compatible object storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=cropscan-media
S3_REGION=us-east-1
SIGNED_URL_TTL_SECONDS=3600

# Razorpay TEST MODE ONLY. Keys must start with rzp_test_
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Model artefacts directory (model.onnx, labels.json, meta.json)
MODEL_DIR=services/api/model

# Shared content directory (disease_info.json, disease_cycle.json, translations)
DATA_DIR=data

# Phase 10 stretch. Default off.
LEDGER_ANCHOR_ENABLED=false
POLYGON_AMOY_RPC_URL=
POLYGON_AMOY_PRIVATE_KEY=

# --- Local laptop demo (services/api/dev_local.py reads services/api/.env) ---
# SQLite + local media instead of Postgres/MinIO; never set LOCAL_MEDIA_DIR in a deployment.
HOST=127.0.0.1
PORT=8000
PUBLIC_BASE_URL=http://127.0.0.1:8000
LOCAL_MEDIA_DIR=

# CropScan XR: Enter the field opens the Unity app on the same PC (loopback callers only).
XR_LOCAL_LAUNCH=false
XR_UNITY_PROJECT_PATH=
XR_UNITY_EDITOR_PATH=
XR_PLAYER_PATH=
